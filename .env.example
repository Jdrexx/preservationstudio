# preservation.studio — local development environment template.
# Copy to .env and adjust (the repo runs fine with NO .env locally — these
# are the variables Railway sets in production).

# Debug on for local development; MUST be 0 on Railway.
DJANGO_DEBUG=1

# Production only: a long random value. The local default is insecure by
# design and Django refuses to run with it when DEBUG=0.
DJANGO_SECRET_KEY=

# Comma-separated allowed hosts. Local: localhost,127.0.0.1.
# Railway: your public domain + ,.up.railway.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Admin is mounted only when set (unset = admin disabled, /admin/ 404s).
# Use a non-guessable path, e.g. studio-admin.
DJANGO_ADMIN_URL=

# Transport security (defaults are safe: cookies/HSTS auto-enable when
# DJANGO_DEBUG=0). Explicit overrides if you ever need them:
# DJANGO_SECURE_COOKIES=1
# DJANGO_HSTS_SECONDS=15552000
# DJANGO_SECURE_SSL_REDIRECT=0

# Email alerts for form submissions. Unset NOTIFY_EMAIL = no emails sent,
# submissions are still saved to the admin.
#
# This domain's mail is on iCloud (MX mx01/mx02.mail.icloud.com), so the
# branded sender is:
#   DJANGO_EMAIL_HOST=smtp.mail.me.com
#   DJANGO_EMAIL_PORT=587
#   DJANGO_EMAIL_USER=hello@preservation.studio
#   DJANGO_EMAIL_PASSWORD=<app-specific password from appleid.apple.com>
# DJANGO_EMAIL_USE_TLS=1
#
# Do NOT put a period in the display name unless you quote it — Django's
# SMTP backend rejects `preservation.studio <...>` at send time and the
# failure is silent. studio/checks.py (studio.E002) blocks the deploy.
DJANGO_NOTIFY_EMAIL=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_FROM_EMAIL=Preservation Studio <no-reply@preservation.studio>

# Railway injects DATABASE_URL (Postgres). Unset = local SQLite.
DATABASE_URL=
